             \edef\tempbegin{\noexpand\begin{taskEX}[counter-format=\@nameuse{extest@enum@\detokenize{#1}}](#2)}\tempbegin%
          \else%
             \extestProcessCustomEnum{#1}{#2}%
          \fi}%
}
\NewDocumentEnvironment{enumEX}{ O{} G{1} }{%
    \GiamKhoangTrangThua%
    \def\extest@enumEX@opt{#1}%
    \def\extest@enumEX@cols{#2}%
    \ifnum0#2=00\relax % Nếu nhập 0
        \ifnum0\extest@force@zero@cols=00\relax % CÔNG TẮC ĐANG TẮT
            \expandafter\extest@grab@enumEX
        \else % CÔNG TẮC ĐANG BẬT
            \expandafter\extest@start@enumEX\expandafter{\extest@enumEX@opt}{\extest@force@zero@cols}%
        \fi
    \else % Nếu nhập số cột bình thường
        \extest@start@enumEX{#1}{#2}%
    \fi
}{%
    \ifnum0\extest@enumEX@cols=00\relax
        \ifnum0\extest@force@zero@cols=00\relax
        \else% Chế độ hút nội dung đã tự động đóng \end{taskEX}
            \end{taskEX}%
        \fi
