\newcommand{\inputans}[3][]{%
	\def\extest@opt{#1}\def\extest@one{1}%
	\ifx\extest@opt\extest@one \Fullcirc \else\Onlycirc\fi%
	\in@{,}{#2}%
	\ifin@
		\def\numABCD{\expandafter\firstofthreeaux#2\relax}%
		\def\numTF{\expandafter\secondofthreeaux#2\relax}%
		\def\numSA{\expandafter\thirdofthreeaux#2\relax}%
		\Onlycirc%
	\else
		\def\numABCD{#2}\def\numTF{#2}\def\numSA{#2}%
	\fi
	{\fontfamily{qcs}\small\selectfont%
	\RenewEnviron{Solution}[2][]{%
		\findkindans{\BODY}%
		\def\SttANS{##2}\def\nobox{1}%
		\ifstrempty{##1}{}{\def\nameans{##1}}%
		\ifnum\kindans=10\relax
			\setlength{\dorongANS}{\dimexpr\linewidth/#2-4.2\fboxsep\relax}%
			\BODY
		\else\ifnum\kindans=-1\relax
			\setlength{\dorongANS}{\dimexpr\linewidth/\numSA-4.2\fboxsep\relax}%
			\BODY
		\else\ifnum\kindans=-2\relax
			\BuildAnsNoBoxEX{\numTF}{\BODY}%
		\else\ifnum\kindans=1\relax
			\BuildAnsNoBoxEX{\numTF}{\BODY}%
		\else
			\BuildAnsNoBoxEX{\numABCD}{\BODY}%
		\fi\fi\fi\fi%
	}%
	\begin{flushleft}%
		\forcsvlist{\extest@readfile}{#3}%
	\end{flushleft}}%
}
% Lệnh \inputanstab
\newcommand{\inputanstab}[3][1]{%
	\IfInteger{#1}{%
		\ifnum#1>0\relax%
		\renewcommand{\dapsoSA}[2][]{##2}%
		\renewcommand{\circT}[2][]{\stepcounter{dapan}##2) Đ\newline}%
		\renewcommand{\circF}[2][]{\stepcounter{dapan}##2) S\newline}%
		\RenewEnviron{Solution}[2][]{%
			\findkindans{\BODY}%
			\in@{.}{##2}%
			\ifin@
				\edef\SttANS{\expandafter\secondoftwoaux##2\relax}%
			\else
				\edef\SttANS{##2}%
			\fi
			\edef\SttANS{\the\numexpr\SttANS\relax}%
			\edef\colIndex{\the\numexpr (\SttANS-#1) - ((\SttANS-#1)/#2)*#2 \relax}%
			\setcounter{dapan}{0}%
			{\setlength\tabcolsep{3pt}%
			\ifnum\kindans=0\relax % DẠNG 1: TRẮC NGHIỆM ABCD
				\ifnum\colIndex=0\relax%
					\par\vspace{2mm}\noindent%
					\begin{tabular}{|c|}%
					\hline \rule[-1.ex]{0pt}{3.5ex}\bfseries Câu \\ 
					\hline \rule[-1.ex]{0pt}{3.5ex}\bfseries Chọn \\ 
					\hline
					\end{tabular}%
				\fi%
				\begin{tabular}{>{\centering\arraybackslash}m{\dimexpr(\linewidth-2.2cm)/#2-2\tabcolsep\relax}|}%
				\hline \rule[-1.ex]{0pt}{3.5ex}##2 \\ 
				\hline \rule[-1.ex]{0pt}{3.5ex}\BODY \\ 
				\hline
				\end{tabular}%
			\else\ifnum\kindans=-1\relax % DẠNG 2: TRẢ LỜI NGẮN
				\ifnum\colIndex=0\relax
					\par\vspace{2mm}\noindent%
					\begin{tabular}{|c|}%
					\hline \rule[-1.ex]{0pt}{3.5ex}\bfseries Câu \\ 
					\hline \rule[-1.ex]{0pt}{3.5ex}\bfseries Chọn \\ 
					\hline
					\end{tabular}%
				\fi%
				\begin{tabular}{>{\centering\arraybackslash}m{\dimexpr(\linewidth-15mm)/#2-2\tabcolsep\relax}|}%
				\hline \rule[-1.ex]{0pt}{3.5ex}##2 \\ 
				\hline \rule[-1.ex]{0pt}{3.5ex}\BODY \\ 
				\hline
				\end{tabular}%
			\else\ifnum\kindans=1\relax % DẠNG 3: ĐÚNG / SAI
				\ifnum\colIndex=0\relax%
					\par\vspace{2mm}\noindent%
					\begin{tabular}{|>{\centering\arraybackslash}m{\dimexpr\linewidth/#2-2\tabcolsep-1mm\relax}|}%
				\else
