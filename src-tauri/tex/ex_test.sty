\cs_new_protected:Npn \__listsEX_parse_item_aux_ii:w [#1]
  {
    \tl_set:Nn \l__listsEX_tmp_label_tl {#1}
    \tl_if_eq:VnTF \l__listsEX_tmp_label_tl { $listsEX$default$label$ }
      {
        \bool_if:NTF \l__listsEX_enumerate_bool
          {
            \int_gincr:N \g__listsEX_int
            \setcounter{numitem}{\int_use:N \g__listsEX_int}
            \SaveCounterPatternFrom [listsEX] \l__listsEX_tmpa_tl \l__listsEX_current_label_tl \l__listsEX_label_pattern_tl
          }
          {
            \tl_if_blank:VTF \l__listsEX_label_tl
              { \tl_set_eq:NN \l__listsEX_current_label_tl \labelitemi }
              { \tl_set_eq:NN \l__listsEX_current_label_tl \l__listsEX_label_tl }
          }
      }
      { \tl_set_eq:NN \l__listsEX_current_label_tl \l__listsEX_tmp_label_tl }

    \tl_put_left:NV  \l__listsEX_current_label_tl \l__listsEX_label_format_tl
    \tl_put_left:NV  \l__listsEX_current_label_tl \l__listsEX_label_prefix_tl
    \tl_put_right:NV \l__listsEX_current_label_tl \l__listsEX_label_suffix_tl

    \bool_if:NT \l__listsEX_item_full_line_bool
      {
        \box_if_empty:NF \g__listsEX_row_box
          {
            \noindent \skip_horizontal:N \l__listsEX_item_indent_dim
            \box_use:N \g__listsEX_row_box \box_gclear:N \g__listsEX_row_box \par
            \prevdepth=\dp\strutbox \vspace{\l__listsEX_after_item_skip}
            \int_gset:Nn \g__listsEX_current_col_num_int { 0 }
          }
      }
    \int_gincr:N \g__listsEX_current_col_num_int
    \int_compare:nNnT { \g__listsEX_current_col_num_int } > { \l__listsEX_columns_int }
      {
        \int_gset:Nn \g__listsEX_current_col_num_int { 1 }
        \int_gincr:N \g__listsEX_current_row_num_int
        \vspace{\glueexpr\l__listsEX_after_item_skip - \parskip \relax} %DPS after-item
      }
    \dim_set:Nn \l__listsEX_item_width_dim
      {
        \bool_if:NTF \l__listsEX_item_full_line_bool
          { \linewidth - \l__listsEX_depth_int \l__listsEX_item_indent_dim }
          { ( \linewidth - \l__listsEX_depth_int \l__listsEX_item_indent_dim - \l__listsEX_columns_int \l__listsEX_column_sep_dim + \l__listsEX_column_sep_dim ) / \l__listsEX_columns_int }
        \bool_if:NT \l__listsEX_debug_bool { -2 \fboxrule }
      }
    \bool_if:NT \l__listsEX_item_rest_of_line_bool
      {
        \int_set:Nn \l__listsEX_tmpa_int { \l__listsEX_columns_int - \g__listsEX_current_col_num_int + 1 }
        \int_compare:nNnTF { \l__listsEX_item_columns_int } = { 0 }
          { \int_set:Nn \l__listsEX_tmpb_int { \l__listsEX_tmpa_int - 1 } }
          {
            \int_compare:nNnTF { \l__listsEX_tmpa_int } > { \l__listsEX_item_columns_int }
              { \int_set_eq:NN \l__listsEX_tmpa_int \l__listsEX_item_columns_int }
              { \int_zero:N \l__listsEX_item_columns_int }
            \int_set:Nn \l__listsEX_tmpb_int { \l__listsEX_tmpa_int - 1 }
          }
        \dim_set:Nn \l__listsEX_item_width_dim
          {
            \l__listsEX_tmpa_int \l__listsEX_item_width_dim
            + \l__listsEX_tmpb_int \l__listsEX_column_sep_dim
            + \l__listsEX_tmpb_int \l__listsEX_item_indent_dim
            \bool_if:NT \l__listsEX_debug_bool { + \numexpr \l__listsEX_tmpb_int * 2 \relax \fboxrule }
          }
        \int_gset_eq:NN \g__listsEX_current_col_num_int \l__listsEX_columns_int
      }
    \int_compare:nNnTF { \l__listsEX_columns_int } = { 1 }
      { \par
        \group_begin:
          \dim_set_eq:NN \leftskip \l__listsEX_item_indent_dim
          \noindent
          \listsEX_resolve_align_char:
          \llap {
            \makebox[\l__listsEX_label_width_dim][\l__listsEX_label_align_char_tl]{\l__listsEX_current_label_tl}
            \skip_horizontal:N \l__listsEX_label_offset_dim
          }
          \__listsEX_setup:
          \l__listsEX_item_format_tl
          \ignorespaces }
      { \vcoffin_set:Nnw \l__listsEX_item_coffin { \l__listsEX_item_width_dim }
        \__listsEX_setup:
        \l__listsEX_item_format_tl
        \ignorespaces }
  }

\cs_new_protected:Npn \__listsEX_draw_column_sep:
