				\global\expandafter\let\csname orig@endloigiai@##1\endcsname\endloigiai
				\exedethi%
				\global\def\loigiai{%
					\labelex\gdef\labelex{}%
					\gdef\extest@loigiai@tcb{0}%
					\ifInTcolorbox\ifdefined\endbox\ifx\endbox\empty\else\endgroup\endbox\gdef\endbox{}\begingroup\def\@currenvir{loigiai}\gdef\extest@loigiai@tcb{1}\fi\fi\fi%
					\par\noindent%
