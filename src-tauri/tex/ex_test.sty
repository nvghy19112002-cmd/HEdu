		{\setlength{\dorong}{\dimexpr(\linewidth - 4\fboxsep)/#1 - \widthalpha - 3\fboxsep-0.5pt\relax}}%
		{\setlength{\dorong}{\dimexpr\linewidth - 4\fboxsep - \widthalpha - 3\fboxsep-0.5pt\relax}}%
	\setcounter{debai}{1}%
	\IfInteger{#1}{\writeChoice[#1]}{\writeChoice}%
}
