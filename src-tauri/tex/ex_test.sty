\newcommand{\shortansfix}[2][]{%
	\ifnum\RM=0\relax\renewcommand{\Hfill}{\!\!\!\!\!}%
		\def\ketquaSA{\phantom{I}}%
	\fi%
	\ifnum\pdf@strcmp{#1}{00}=0%
	\else\ifnum\pdf@strcmp{#1}{0}=0%
		\ifnum\RM=0\relax\oKQ[\typekindSA]{}\!\fi%
	\else\ifnum\pdf@strcmp{#1}{}=0%
		\Hfill\oKQ{\widthSA}\ifInList{\hspace{-1mm}}{\par}%
	\else\ifnum\pdf@strcmp{#1}{oly}=0%
		\Hfill\oKQ[oly]{4}\ifInList{\hspace{-1mm}}{\par}%
	\else\ifnum\pdf@strcmp{#1}{...}=0%
		\Hfill\oKQ[...]{\widthSA}\ifInList{\hspace{-1mm}}{\par}%
	\else%
		\IfInteger{#1}%
		{\Hfill\oKQ{#1 cm}\ifInList{\hspace{-1mm}}{\par}}%
		{\oKQ[#1]{}\!}%
	\fi\fi\fi\fi\fi%
}
