\newcommand{\writeChoiceTF}[2]{%
	\ifcase\cotDS\ifnum\cotSTT=1 \cline{1-2}\cline{4-5}\else\cline{1-1}\cline{3-3}\fi%
		\or \ifnum\cotSTT=1\cline{1-3}\cline{5-7}\else\cline{1-2}\cline{4-5}\fi%
		\or \ifnum\cotSTT=1\cline{1-4}\cline{6-9}\else\cline{1-3}\cline{5-7}\fi%
	\fi%
	\ifnum\value{dapan}=3\addtocounter{dapan}{-2}\fi%
	\xdef\dotEX{\sdotEX}%
	\ifnum\value{dapan}=0\writekeyTFone\fi%
	\noindent\hspace*{-1.3mm}%
		\renewenvironment{center}%
			{\par\xdef\dotEX{}\centering}%
			{\leavevmode\unskip\par}%
		\begindapanTFt[haibang]%
			#1\unskip\dotEX\strut%
		\ifnum\addquestions=1\relax\gandeTFaddanswers{#1}\fi%
	\end{minipage}\vspace*{1pt}%
	\xdef\dotEX{\sdotEX}%
	\ifcase\value{dapan}\relax%
		\or \stepcounter{dapan}%
		\or \stepcounter{dapan}%
	\fi%
	\writekeyTF&&%
	\noindent\hspace*{-1.3mm}%
		\renewenvironment{center}%
			{\par\xdef\dotEX{}\centering}%
			{\leavevmode\unskip\par}%
		\begindapanTFt[haibang]%
			#2\unskip\dotEX\strut%
		\ifnum\addquestions=1\relax\gandeTFaddanswers{#2}\fi% 
	\end{minipage}\vspace*{1pt}%
	\xdef\dotEX{\sdotEX}%
	\writekeyTF\tabularnewline%
}

