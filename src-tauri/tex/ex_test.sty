\@ifundefined{AddToHook}{% Phát hiện TeXLive cũ (trước 2021)
    \RequirePackage{expl3,xparse,xfp}%
    \newcommand{\AddToHook}[2]{%
        \in@{env/}{#1}%
        \ifin@ \expandafter\extest@parsehook#1\relax{#2}%
        \else \in@{begindocument}{#1}%
            \ifin@\AtBeginDocument{#2}\fi\fi}%
    \def\extest@parsehook env/#1/#2\relax#3{%
        \def\extest@pos{#2}%
        \def\extest@before{before}%
        \def\extest@begin{begin}%
        \def\extest@end{end}%
        \def\extest@after{after}%
        \ifx\extest@pos\extest@before\BeforeBeginEnvironment{#1}{#3}%
        \else\ifx\extest@pos\extest@begin\AtBeginEnvironment{#1}{#3}%
        \else\ifx\extest@pos\extest@end\AtEndEnvironment{#1}{#3}%
        \else\ifx\extest@pos\extest@after\AfterEndEnvironment{#1}{#3}%
        \fi\fi\fi\fi}%
}{}
\newcommand{\IfSubStrEX}[4]{%Thay lệnh \IfSubStr của gói xstring
	\protected@edef\extest@haystack{#1}%
	\protected@edef\extest@needle{#2}%
	\edef\extest@run{%
		\noexpand\in@
		{\expandafter\detokenize\expandafter{\extest@needle}}%
		{\expandafter\detokenize\expandafter{\extest@haystack}}%
	}\extest@run%
	\ifin@ \expandafter\@firstoftwo%
	\else \expandafter\@secondoftwo%
	\fi%
	{#3}{#4}%
}
