%\shortans
\tl_new:N \l_extest_split_tl
\int_new:N \l_extest_len_int
\bool_new:N \l_extest_valid_bool
\bool_new:N \l_extest_prevbs_bool
\cs_new_protected:Npn \__extest_add_char:n #1
  {
    \int_incr:N \l_extest_len_int
    \int_compare:nNnTF { \l_extest_len_int } > { 4 }
      { \bool_set_false:N \l_extest_valid_bool }
      { \expandafter \xdef \csname extest@anschar \int_use:N \l_extest_len_int \endcsname { #1 } }
  }
\cs_new_protected:Npn \extest_scan_fast:n #1
  {
    \int_zero:N \l_extest_len_int
    \bool_set_true:N \l_extest_valid_bool
    \bool_set_false:N \l_extest_prevbs_bool
    \tl_set:Nx \l_extest_split_tl { \tl_to_str:n { #1 } }
    \tl_map_inline:Nn \l_extest_split_tl
      {
        \bool_if:NT \l_extest_valid_bool
          {
            \tl_if_blank:nTF { ##1 }
              { \int_set:Nn \l_tmpa_int { 32 } }
              { \int_set:Nn \l_tmpa_int { `##1 } }
            \int_case:nnF { \l_tmpa_int }
              {
                { 92 }  { \bool_set_true:N \l_extest_prevbs_bool } % Ký tự \
                { 32 }  { } % Space
                { 36 }  { } % $
                { 123 } { } % {
                { 125 } { } % }
                { 126 } { } % ~
                { 59 }  { } % ;
                { 45 }  { % Dấu trừ -
                    \bool_set_false:N \l_extest_prevbs_bool
                    \__extest_add_char:n { ##1 }
                }
                { 44 }  { % Dấu phẩy ,
                    \bool_if:NTF \l_extest_prevbs_bool
                      { \bool_set_false:N \l_extest_prevbs_bool }
                      { \__extest_add_char:n { ##1 } }
                }
              }
              { % Mặc định: kiểm tra số 0-9
                \bool_set_false:N \l_extest_prevbs_bool
                \bool_lazy_and:nnTF 
                  { \int_compare_p:nNn { \l_tmpa_int } > { 47 } }
                  { \int_compare_p:nNn { \l_tmpa_int } < { 58 } }
                  { \__extest_add_char:n { ##1 } } % Là số hợp lệ
                  { \bool_set_false:N \l_extest_valid_bool } % Ký tự rác -> Hủy bảng
              }
          }
      }
    \bool_if:NTF \l_extest_valid_bool
      {
        \xdef \extest@isnum { 1 }
        \xdef \extest@len { \int_use:N \l_extest_len_int }
      }
      {
        \xdef \extest@isnum { 0 }
        \xdef \extest@len { 0 }
      }
  }
