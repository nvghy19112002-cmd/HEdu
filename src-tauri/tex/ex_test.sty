			\or \xdef\saveFileAns{\saveFileAns\string\circF{\DapAnTF}}\xdef\keyEX{\DapAnTF)\ sai}%
			\or \xdef\saveFileAns{\saveFileAns\string\circF{\DapAnTF}\saveFileAnsTempC}\xdef\keyEX{\keyEX\ \big| \DapAnTF)\ sai\ \keyEXTempC}%
			\or \xdef\saveFileAnsTempC{\string\circF{\DapAnTF}}\xdef\keyEXTempC{\big| \DapAnTF)\ sai}%
			\or \xdef\saveFileAns{\saveFileAns\string\circF{\DapAnTF}}\xdef\keyEX{\keyEX\ \big| \DapAnTF)\ sai}%
			\fi
