			\ifcase\value{dapan}\relax
			\or \xdef\saveFileAns{\saveFileAns\string\circT{\DapAnTF}}\xdef\keyEX{\DapAnTF)\ đúng}%
			\or \xdef\saveFileAns{\saveFileAns\string\circT{\DapAnTF}\saveFileAnsTempC}\xdef\keyEX{\keyEX\ \big| \DapAnTF)\ đúng\ \keyEXTempC}%
			\or \xdef\saveFileAnsTempC{\string\circT{\DapAnTF}}\xdef\keyEXTempC{\big| \DapAnTF)\ đúng}%
			\or \xdef\saveFileAns{\saveFileAns\string\circT{\DapAnTF}}\xdef\keyEX{\keyEX\ \big| \DapAnTF)\ đúng}%
			\fi%
			\ifnum\addanswers=1\relax\gandaTFaddanswers{\usebox{\itemchT}}\fi%
		\else
			\ifnum\chType=1\relax
				\xdef\saveFileAns{\saveFileAns\string\circT{\DapAnTF}}%
				\ifnum\value{dapan}=1\relax \xdef\keyEX{\DapAnTF)\ đúng}%
				\else \xdef\keyEX{\keyEX\ \big| \DapAnTF)\ đúng}\fi%
				\ifnum\addanswers=1\relax\gandaTFaddanswers{\usebox{\itemchT}}\fi%
			\else
				\xdef\saveFileAns{\Alph{dapan}}\xdef\keyEX{\Alph{dapan}}%
			\fi%
		\fi%
	}
	{
		\ifnum\cotSTT=1\relax%
			\def\extestCell{\vspace*{1pt}\centering\FalseTF& \par\vspace*{2pt}\noindent}%
		\else
			\def\extestCell{\par\vspace{2pt-\baselineskip}\noindent \begin{minipage}[t]{\widthalpha}\FalseTF\end{minipage}\hspace*{2\fboxsep}}%
