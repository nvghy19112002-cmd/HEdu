\def\extest@smart@loigiai{%
    \def\extest@target{loigiai}%
    \ifx\@currenvir\extest@target%
        \expandafter\extest@orig@loigiai%
    \else%
        \expandafter\extest@cmd@loigiai%
    \fi%
}
\def\SetupSmartLoiGiai{%
    \ifx\loigiai\extest@smart@loigiai\relax%
    \else%
