\newcommand{\writeChoice}[2][1]{%
	\xdef\dotEX{\sdotEX}%
	\ifnum\value{debai}=1\relax%
		\ifnum\value{dapan}>0\relax%
			\par\setlength{\parskip}{\pkchoice}%
		\fi%
		\noindent\hspace*{5\fboxsep}%
	\else\noindent\hspace*{\fboxsep}%
	\fi%
	\begingroup%
		\renewenvironment{center}%
			{\par\xdef\dotEX{}\centering}%
			{\leavevmode\unskip\par}%
		\begindapan%
			#2\unskip\dotEX%
	\end{minipage}%
	\endgroup%
	\ifnum\addanswers=1\relax\ifnum\chType=1\relax\ifnum\addquestions=1\relax%
		\gandeTFaddanswers{#2}%
	\fi\fi\fi%
	\stepcounter{debai}%
	\ifnum\value{debai}>#1\relax%
		\setcounter{debai}{1}%
	\fi%
	\@ifnextchar\bgroup{\writeChoice[#1]}{}%
}
