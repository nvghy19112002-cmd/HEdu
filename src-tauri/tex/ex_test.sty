\def\DanhSachChoiceTF{}
\newcommand{\choiceTF}[2][\parskipchoice]{\gdef\chType{1}%
	\xdef\sdotEX{\dotEX}%
	\xdef\numPA{\the\numexpr\numPA+1\relax}%
	\xdef\DanhSachChoiceTF{\unexpanded\expandafter{\DanhSachChoiceTF}\unexpanded{{#2}}}%
	\@ifnextchar\bgroup{\choiceTF[#1]}{%
		\def\isTmode{4}% Mặc định
		\ifnum\pdf@strcmp{\kindTF}{0}=0 \def\isTmode{0}\else
		\ifnum\pdf@strcmp{\kindTF}{t}=0 \def\isTmode{3}\else
		\ifnum\pdf@strcmp{\kindTF}{1t}=0 \def\isTmode{1}\else
		\ifnum\pdf@strcmp{\kindTF}{t0}=0 \def\isTmode{3}\else
		\ifnum\pdf@strcmp{\kindTF}{t01}=0 \def\isTmode{3}\else
		\ifnum\pdf@strcmp{\kindTF}{t10}=0 \def\isTmode{3}\else
		\ifnum\pdf@strcmp{\kindTF}{tDS}=0 \def\isTmode{3}\else
		\ifnum\pdf@strcmp{\kindTF}{2t}=0 \def\isTmode{2}%
		\fi\fi\fi\fi\fi\fi\fi\fi%
		\ifnum\isTmode=4\relax%
			\ifnum\pdf@strcmp{#1}{t}=0 \def\isTmode{3}\else
			\ifnum\pdf@strcmp{#1}{1t}=0 \def\isTmode{1}\else
			\ifnum\pdf@strcmp{#1}{2t}=0 \def\isTmode{2}\fi\fi\fi%
		\fi%
		\edef\ThucThiLenh{%
			\ifnum\numPA=4\relax%
				\ifcase\isTmode\relax%
					\noexpand\choiceTFfour\unexpanded\expandafter{\DanhSachChoiceTF}%
				\or \noexpand\choiceTFfourT[1t]\unexpanded\expandafter{\DanhSachChoiceTF}%
				\or \noexpand\choiceTFfourT[2t]\unexpanded\expandafter{\DanhSachChoiceTF}%
				\or \noexpand\choiceTFfourT[#1]\unexpanded\expandafter{\DanhSachChoiceTF}%
				\or \noexpand\choiceTFfour[#1]\unexpanded\expandafter{\DanhSachChoiceTF}%
				\fi%
			\else%
				\ifcase\isTmode\relax%
					\noexpand\choiceFix\unexpanded\expandafter{\DanhSachChoiceTF}%
				\or \noexpand\choiceTFt\unexpanded\expandafter{\DanhSachChoiceTF}%
				\or \noexpand\choiceTFt\unexpanded\expandafter{\DanhSachChoiceTF}%
				\or \noexpand\choiceTFt\unexpanded\expandafter{\DanhSachChoiceTF}%
				\or \noexpand\choiceFix[#1]\unexpanded\expandafter{\DanhSachChoiceTF}%
				\fi%
			\fi%
        }%
        \ThucThiLenh%
        \xdef\numPA{0}%
        \gdef\DanhSachChoiceTF{}%
	}%
}
\newcommand{\choiceTFfour}[5][\parskipchoice]{\savekinditch%
	\ifnum\saplai=1\relax%
		\MeasureChoice{\widthcha}{#2}%
		\MeasureChoice{\widthchb}{#3}%
		\MeasureChoice{\widthchc}{#4}%
		\MeasureChoice{\widthchd}{#5}%
		\setlength{\MO}{\dimexpr9\linewidth\relax}%
		\setlength{\HA}{\dimexpr(\linewidth - 4\fboxsep)/2-\widthalpha-3\fboxsep\relax}%
		\setlength{\BA}{\dimexpr(\linewidth - 4\fboxsep)/3-\widthalpha-3\fboxsep\relax}%
		\setlength{\BO}{\dimexpr(\linewidth - 4\fboxsep)/4-\widthalpha-3\fboxsep\relax}%
		\setlength{\rMO}{\dimexpr(\linewidth- 4\fboxsep)/1-\widthalpha-3\fboxsep-0.5pt\relax}%
		\setlength{\rHA}{\dimexpr(\linewidth- 4\fboxsep)/2-\widthalpha-3\fboxsep-0.5pt\relax}%
		\setlength{\rBA}{\dimexpr(\linewidth- 4\fboxsep)/3-\widthalpha-3\fboxsep-0.5pt\relax}%
		\setlength{\rBO}{\dimexpr(\linewidth- 4\fboxsep)/4-\widthalpha-3\fboxsep-0.5pt\relax}%
		\gdef\numchoice{0}\gdef\socot{1}%
		\setnumchoice{\BO}{\BO}{\BO}{\BO}{\MO}{1}%
		\setnumchoice{\HA}{\HA}{\HA}{\HA}{\MO}{2}%
		\setnumchoice{\BA}{\BA}{\BA}{\MO}{\MO}{3}%
		\setnumchoice{\MO}{\BA}{\BA}{\BA}{\MO}{4}%
		\setnumchoice{\HA}{\HA}{\MO}{\MO}{\MO}{5}%
		\setnumchoice{\MO}{\MO}{\HA}{\HA}{\MO}{6}%
		\setnumchoice{\MO}{\HA}{\HA}{\MO}{\MO}{7}%
		\setcounter{numChoice}{\numchoice}%
		{\setcounter{debai}{1}%
		 \IfInteger{#1}{% Nếu #1 là số cột cố định
			\ifnum#1<1 \def\socot{1}\else\edef\socot{#1}\fi%
			\setlength{\dorong}{\dimexpr(\linewidth - 4\fboxsep)/\socot-\widthalpha-3\fboxsep-0.5pt\relax}%
			\par\setlength{\parskip}{\pkchoice}\noindent%
			\writeChoice[\socot]{#2}{#3}{#4}{#5}%
		}{\def\pkchoice{#1}\par\setlength{\parskip}{\pkchoice}\noindent%
			\ifcase\value{numChoice}\relax%
				\setlength{\dorong}{\dimexpr(\linewidth - 4\fboxsep)/\socot-\widthalpha-3\fboxsep-0.5pt\relax}%
				\writeChoice[\socot]{#2}{#3}{#4}{#5}
			\or \setlength{\dorong}{\rBO}{\writeChoice[4]{#2}{#3}{#4}{#5}}%
			\or \setlength{\dorong}{\rHA}{\choiceint[2]{#2}{#3}{#4}{#5}}%
			\or \setlength{\dorong}{\rBA}{\writeChoice[3]{#2}{#3}{#4}}\setcounter{debai}{1}%
				{\setlength{\dorong}{\rMO}\writeChoice[1]{#5}}%
			\or \setlength{\dorong}{\rMO}{\writeChoice[1]{#2}}\setcounter{debai}{1}%
				\setlength{\dorong}{\rBA}{\writeChoice[3]{#3}{#4}{#5}}%
			\or \setlength{\dorong}{\rHA}{\writeChoice[2]{#2}{#3}}\setcounter{debai}{1}%
				\setlength{\dorong}{\rMO}{\writeChoice[1]{#4}{#5}}%
			\or \setlength{\dorong}{\rMO}{\writeChoice[1]{#2}{#3}}\setcounter{debai}{1}%
				\setlength{\dorong}{\rHA}{\writeChoice[2]{#4}{#5}}%
			\or \setlength{\dorong}{\rMO}{\writeChoice[1]{#2}}%
				\setlength{\dorong}{\rHA}{\writeChoice[2]{#3}{#4}}\setcounter{debai}{1}%
				\setlength{\dorong}{\rMO}{\writeChoice[1]{#5}}%
			\else% Trường hợp mặc định (Khác các số trên)
				\setlength{\dorong}{\dimexpr(\linewidth - 4\fboxsep)/\socot-\widthalpha-3\fboxsep-0.5pt\relax}%
				\writeChoice[\socot]{#2}{#3}{#4}{#5}%
			\fi}}\par\noindent%
	\else\choiceFix[#1]{#2}{#3}{#4}{#5}\fi%
}
\newcommand{\choiceTFfourT}[5][\parskipchoice]{%
	\gdef\chType{1}\callcotDS%
	\savekinditch%
	\def\reqMode{t}%
	\ifnum\pdf@strcmp{\kindTF}{1t}=0 \def\reqMode{1t}\else
	\ifnum\pdf@strcmp{\kindTF}{2t}=0 \def\reqMode{2t}\else
	\ifnum\pdf@strcmp{#1}{1t}=0 \def\reqMode{1t}\else
	\ifnum\pdf@strcmp{#1}{2t}=0 \def\reqMode{2t}\fi\fi\fi\fi%
	{\setlength{\TabCS}{\tabcolsep}%
		\ifInMulticol{\choiceTFt{#2}{#3}{#4}{#5}}%
		{\ifnum\pdf@strcmp{\reqMode}{1t}=0 \choiceTFt{#2}{#3}{#4}{#5}\else
		 \ifnum\pdf@strcmp{\reqMode}{2t}=0 \haibang{#2}{#3}{#4}{#5}\else
		 \ifnum\pdf@strcmp{\reqMode}{t}=0%
			\MeasureChoice{\widthcha}{#2}%
			\MeasureChoice{\widthchb}{#3}%
			\MeasureChoice{\widthchc}{#4}%
			\MeasureChoice{\widthchd}{#5}%
			\setlength{\widthch}{\widthcha}%
			\ifdim\widthch<\widthchb\relax\setlength{\widthch}{\widthchb}\fi%
			\ifdim\widthch<\widthchc\relax\setlength{\widthch}{\widthchc}\fi%
			\ifdim\widthch<\widthchd\relax\setlength{\widthch}{\widthchd}\fi
			\ifcase\cotDS%
				\ifnum\cotSTT=1 \setlength{\HA}{\dimexpr\linewidth/2-\lengthTT-4\TabCS-5mm\relax}%
				\else \setlength{\HA}{\dimexpr\linewidth/2-\widthalpha-2\TabCS-5mm-2\fboxsep\relax}\fi%
			\or \ifnum\cotSTT=1 \setlength{\HA}{\dimexpr\linewidth/2-\lengthTT-6\TabCS-1\lengthDS-5mm\relax}%
				\else \setlength{\HA}{\dimexpr\linewidth/2-\widthalpha-4\TabCS-1\lengthDS-5mm-2\fboxsep\relax}\fi%
			\or \ifnum\cotSTT=1 \setlength{\HA}{\dimexpr\linewidth/2-\lengthTT-8\TabCS-2\lengthDS-5mm\relax}%
				\else \setlength{\HA}{\dimexpr\linewidth/2-\widthalpha-6\TabCS-2\lengthDS-5mm-2\fboxsep\relax}\fi%
			\fi%
			\ifdim\widthch<\HA\relax
				\haibang{#2}{#3}{#4}{#5}%
			\else%
				\choiceTFt{#2}{#3}{#4}{#5}%
			\fi%
		 \fi\fi\fi}}%
}
