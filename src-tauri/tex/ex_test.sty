\newcommand{\shortans}[2][]{\relax%
	\gdef\chType{-1}%
	\savekinditch\def\typekindSA{#1}%
	\def\isSpecialSA{0}%
	\ifnum\pdf@strcmp{#1}{}=0 \def\isSpecialSA{1}\else
	\ifnum\pdf@strcmp{#1}{oly}=0 \def\isSpecialSA{1}\else
	\ifnum\pdf@strcmp{#1}{...}=0 \def\isSpecialSA{1}\fi\fi\fi%
	\IfInteger{#1}{\def\RM{1}}{\def\RM{\isSpecialSA}}%
	\ifnum\pdf@strcmp{\kindSA}{}=0 
		\shortansfix[#1]{\Split{#2}}%
	\else\ifnum\pdf@strcmp{\kindSA}{ShowSAKeyColor}=0
		\ifnum\isSpecialSA=1\relax%
			\Hfill\raisebox{0pt}{\tikz[baseline=(char.base)]{\node (char)[rectangle,inner sep=2pt,rounded corners=2pt,fill=yellow!50,draw=red]{\color{red}~\selectshortans\ \Split{#2}\phantom{~}};}}\ifInList{\hspace{-1mm}}{\par}%
		\else\raisebox{0pt}{\tikz[baseline=(char.base)]{\node (char)[rectangle,inner sep=2pt,rounded corners=2pt,fill=yellow!50,draw=red]{\color{red}\Split{#2}};}}\fi%
	\else\ifnum\pdf@strcmp{\kindSA}{ShowSAKeyLG}=0
		\ifnum\isSpecialSA=1\relax%
			\Hfill\raisebox{0pt}{\tikz[baseline=(char.base)]{\node (char)[rectangle,inner sep=2pt,rounded corners=2pt]{\color{red}~\selectshortans\ \Split{#2}\phantom{~}};}}\ifInList{\hspace{-1mm}}{\par}%
		\else\raisebox{0pt}{\tikz[baseline=(char.base)]{\node (char)[rectangle,inner sep=2pt,rounded corners=2pt]{\color{red}\Split{#2}};}}\fi%
	\else
		\shortansfix[\kindSA]{\Split{#2}}%
	\fi\fi\fi%
	\xdef\saveKQ{\detokenize{#2}}\gdef\keyEX{#2}%
	\ifInList%
	{\stepcounter{dapan}%
		\xdef\saveFileAns{\saveFileAns\ifnum\thedapan>1\relax\@percentchar^^J\fi\string\dapsoSA[\DapAnSA]\detokenize{{#2}}}}
	{\xdef\saveFileAns{\string\dapsoSA\detokenize{{#2}}}}%
}
