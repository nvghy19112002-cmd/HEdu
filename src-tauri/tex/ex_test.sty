%Ghi đáp số bên phải  câu hỏi
\newcommand{\dapso}[2][a]{}
\newcommand{\@dapsoCore}[2]{\gdef\chType{10}%
	\ifInList%
	{\stepcounter{dapan}%
		\ifnum\pdf@strcmp{#1}{1}=0\relax
			\xdef\saveFileAns{\saveFileAns\string\dapsoTL[\arabic{dapan}]\detokenize{{#2}}}%
		\else\ifnum\pdf@strcmp{#1}{A}=0\relax
			\xdef\saveFileAns{\saveFileAns\ifnum\thedapan>1\relax\@percentchar^^J\fi\string\dapsoTL[\Alph{dapan}]\detokenize{{#2}}}%
		\else
			\xdef\saveFileAns{\saveFileAns\ifnum\thedapan>1\relax\@percentchar^^J\fi\string\dapsoTL[\alph{dapan}]\detokenize{{#2}}}%
		\fi\fi%
	}{\xdef\saveFileAns{\string\dapsoTL\saveFileAns\detokenize{{#2}}}}%
	\xdef\saveKQ{\detokenize{#2}}%
}
