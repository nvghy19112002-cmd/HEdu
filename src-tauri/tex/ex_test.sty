\NewDocumentCommand{\createbox}{o m o}{%
	\csgdef{extest@isBoxed@#2}{1}%
	\IfNoValueTF{#1}{}{%
		\theoremstyle{inboxtitle}\theorembodyfont{\normalfont}\renewtheorem{#2}{#1}%
		\AddToHook{env/#2/begin}{\tcbset{%
			fonttitle=\selectfont\bfseries,
			title={\labelthm\ \Currentlabel}}}%
	}%
	\AddToHook{env/#2/begin}{%
		\begingroup
		\def\extest@ex{ex}\def\extest@vd{vd}\def\extest@arg{#2}%
		\ifx\extest@arg\extest@ex \ifInex\setcounter{env}{\value{ex}}\fi \fi
		\ifx\extest@arg\extest@vd \ifInvd\setcounter{env}{\value{vd}}\fi \fi
		% -----------------------------------------------------
		\refstepcounter{#2}\addtocounter{#2}{-1}%
		\renewcommand{\Currentlabel}{\@currentlabel}%
		\IfNoValueTF{#1}{}{\gdef\labelthm{#1}}%
		\IfNoValueTF{#3}{\IfNoValueTF{#1}{\beginboxI}{\beginboxII}}{#3}%
		\tikzset{every node/.append style={fill=tcbcolback,opacity=1}}%
		\tikzset{double style/.append style={double distance=1.6pt,double=tcbcolback}}%
		\gdef\endbox{\end{tcolorbox}}%
		% -----------------------------------------------------
		\AddToHook{env/loigiai/end}{\def\finishLG{}%
			\IfSubStrEX{,solcolor,loigiai,}{,\kindOPTN,}
			{\ifdefempty{\keyEX}{}{\leavevmode\textchoice\ignorespaces\xdef\keyEX{}}}
			{}}%
	}
	\AddToHook{env/#2/end}{%
		\ifx\endbox\empty\else\endbox\gdef\endbox{}\fi
		\endgroup
	}%
	\ifdefined\chcHooksRegistered\else
		\gdef\chcHooksRegistered{1}%
		\AddToHook{env/chc/before}{%
			\ifx\endbox\empty\else\endbox\gdef\endbox{}\fi%
			\let\labelthmex\labelthm
			\ifnum\numchc=0\relax
				\def\labelthm{}%
				\renewcommand{\thechc}{\unskip\theenv.\arabic{chc}}%
			\else
				\ifInex\let\chc\ex\else\ifInvd\let\chc\vd\fi\fi
				\renewcommand{\thechc}{\theenv}%
			\fi
		}%
		\AddToHook{env/chc/begin}{%
			\refstepcounter{chc}%
			\renewcommand{\Currentlabel}{\@currentlabel}%
			\IfNoValueTF{#1}{\addtocounter{chc}{-1}}{\theoremstyle{inboxtitle}\renewtheorem{chc}{#1}}%
			\def\doBox{0}%
			\ifInex
			    \ifcsdef{extest@isBoxed@ex}{\def\doBox{1}}{}%
			\else\ifInvd
			    \ifcsdef{extest@isBoxed@vd}{\def\doBox{1}}{}%
			\fi\fi
			\ifnum\doBox=1\relax
				\IfNoValueTF{#3}{\IfNoValueTF{#1}{\beginboxI}{\beginboxII}}{#3}%
				\IfNoValueTF{#1}{}{\addtocounter{chc}{-1}}%
				\tikzset{node style/.append style = {fill=tcbcolback,opacity=1}}%
				\tikzset{double style/.append style={double distance=1.6pt,double=tcbcolback}}%
				\gdef\endbox{\end{tcolorbox}}%
			\fi
		}%
		\AddToHook{env/chc/end}{%
			\ifx\endbox\empty\else\endbox\gdef\endbox{}\fi%
		}%
		\AddToHook{env/chc/after}{%
			\let\labelthm\labelthmex%
			\ifnum\numchc>0\relax\IfNoValueTF{#1}{}{\stepcounter{#2}}\fi%
		}%
	\fi%
}
