\newcommand{\@HideChoiceCore}{%
	\renewcommand{\writeChoice}[2][1]{%
		\ifnum\chType=0\relax\else%
			\ifnum\value{debai}=1\relax%
				\ifnum\value{dapan}>0\relax%
					\par\setlength{\parskip}{\pkchoice}\noindent\hspace{0.03\linewidth}%
				\fi%
			\else\noindent\fi%
			\begingroup%
				\renewenvironment{center}{\xdef\dotEX{}\par\centering}{\leavevmode\unskip\par}%
				\begindapan
					##2\unskip\dotEX%
				\end{minipage}%
			\endgroup%
			\ifnum\addanswers=1\relax\ifnum\chType=1\relax\ifnum\addquestions=1\relax%
					\gandeTFaddanswers{##2}%
			\fi\fi\fi%
			\stepcounter{debai}%
			\ifnum\value{debai}>##1\relax\setcounter{debai}{1}\fi%
		\fi%
		\@ifnextchar\bgroup{\writeChoice[##1]}{}%
	}%
}
\NewDocumentCommand{\hidechoice}{o m}{% \hidechoice[<list>]{<môi trường>}
	\IfNoValueTF{#1}%
		{\csgdef{hidechoice#2@all}{1}}%
		{\ifcsdef{hidechoice#2@list}%
			{\csxdef{hidechoice#2@list}{\csuse{hidechoice#2@list},#1}}%
			{\csgdef{hidechoice#2@list}{,#1,}}}%
	\ifcsdef{hidechoice#2hooked}{}{%
		\csgdef{hidechoice#2hooked}{1}%
		\AddToHook{env/#2/begin}{%
			\ifcsdef{hidechoice#2@all}{\@HideChoiceCore}{%
				\edef\extest@target{,\the\numexpr\value{#2}+1\relax,}%
				\edef\extest@list{\csuse{hidechoice#2@list}}%
				\edef\extest@run{\noexpand\in@{\extest@target}{\extest@list}}\extest@run%
				\ifin@ \@HideChoiceCore \fi%
			}%
		}%
	}%
}
%hideenviron
\NewDocumentCommand{\hideenviron}{o m o}{% \hideenviron[<list>]{<môi trường>}[<name>]
	\IfNoValueTF{#1}{\RenewEnviron{#2}{}}%
	{\IfNoValueTF{#3}%
			{\renewcommand{\nameprintex}{\nameex}}%
			{\renewcommand{\nameprintex}{#3}}%
		\RenewEnviron{#2}[1][]{%
			\stepcounter{#2}%
			\edef\extest@target{,\the\value{#2},}%
			\edef\extest@list{,\zap@space#1 \@empty,}%
			\edef\extest@run{\noexpand\in@{\extest@target}{\extest@list}}\extest@run
			\ifin@ \gdef\EXallowPrint{0}\else \gdef\EXallowPrint{1}\fi%
			\ifnum\EXallowPrint=1\relax
				\setcounter{printex}{\numexpr\value{#2}-1\relax}%
				\par%
				\ifstrempty{##1}%
					{\begin{printex}\BODY\end{printex}}%
					{\begin{printex}[##1]\BODY\end{printex}}%
			\fi%
		}%
	}%
}
%printEX
\NewDocumentCommand{\printEX}{o m o}{% \printEX[<list>]{<môi trường>}[name]
	\IfNoValueTF{#3}%
		{\renewcommand{\nameprintex}{\nameex}}%
		{\renewcommand{\nameprintex}{#3}}%
	\RenewEnviron{#2}[1][]{%
		\stepcounter{#2}%
		\IfNoValueTF{#1}%
			{\gdef\EXallowPrint{1}}%
			{\edef\extest@target{,\the\value{#2},}%
			 \edef\extest@list{,\zap@space#1 \@empty,}% Tự động diệt khoảng trắng
			 \edef\extest@run{\noexpand\in@{\extest@target}{\extest@list}}\extest@run
			 \ifin@ \gdef\EXallowPrint{1}\else \gdef\EXallowPrint{0}\fi%
			}% --------------------------------------
		\ifnum\EXallowPrint=1\relax
			\setcounter{printex}{\numexpr\value{#2}-1\relax}\par%
			\ifstrempty{##1}%
				{\begin{printex}\BODY\end{printex}}%
				{\begin{printex}[##1]\BODY\end{printex}}%
		\fi%
	}%
}
