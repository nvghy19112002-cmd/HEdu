\newcommand{\choicefive}[6][\parskipchoice]{\savekinditch%
	\setcounter{debai}{1}%
	\IfInteger{#1}{%
		\ifnum#1<1 \def\socot{1}\else\edef\socot{#1}\fi%
		\setlength{\dorong}{\dimexpr(\linewidth - 4\fboxsep)/\socot-\widthalpha-3\fboxsep-0.5pt\relax}%
		\writeChoice[\socot]{#2}{#3}{#4}{#5}{#6}}%
	{\def\pkchoice{#1}%
		\MeasureChoice{\widthcha}{#2}%
		\MeasureChoice{\widthchb}{#3}%
		\MeasureChoice{\widthchc}{#4}%
		\MeasureChoice{\widthchd}{#5}%
		\MeasureChoice{\widthche}{#6}%
		\setlength{\MO}{\dimexpr9\linewidth\relax}%
		\setlength{\HA}{\dimexpr(\linewidth - 4\fboxsep)/2-\widthalpha-3\fboxsep\relax}%
		\setlength{\BA}{\dimexpr(\linewidth - 4\fboxsep)/3-\widthalpha-3\fboxsep\relax}%
		\setlength{\BO}{\dimexpr(\linewidth - 4\fboxsep)/4-\widthalpha-3\fboxsep\relax}%
		\setlength{\NA}{\dimexpr(\linewidth - 4\fboxsep)/5-\widthalpha-3\fboxsep\relax}%
		\setlength{\RU}{\dimexpr(2\linewidth- 8\fboxsep)/3-\widthalpha-3\fboxsep\relax}%
		\setlength{\rMO}{\dimexpr(\linewidth- 4\fboxsep)/1-\widthalpha-3\fboxsep-0.5pt\relax}%
		\setlength{\rHA}{\dimexpr(\linewidth- 4\fboxsep)/2-\widthalpha-3\fboxsep-0.5pt\relax}%
		\setlength{\rBA}{\dimexpr(\linewidth- 4\fboxsep)/3-\widthalpha-3\fboxsep-0.5pt\relax}%
		\setlength{\rBO}{\dimexpr(\linewidth- 4\fboxsep)/4-\widthalpha-3\fboxsep-0.5pt\relax}%
		\setlength{\rNA}{\dimexpr(\linewidth- 4\fboxsep)/5-\widthalpha-3\fboxsep-0.5pt\relax}%
		\setlength{\rRU}{\dimexpr(2\linewidth- 8\fboxsep)/3-\widthalpha-3\fboxsep-0.5pt\relax}%
		\gdef\numchoice{0}\gdef\socot{1}%
		\setnumchoice{\NA}{\NA}{\NA}{\NA}{\NA}{1}%
		\setnumchoice{\BA}{\BA}{\BA}{\BA}{\RU}{2}%
		\setnumchoice{\BA}{\BA}{\BA}{\RU}{\BA}{3}%
		\setnumchoice{\BA}{\BA}{\BA}{\HA}{\HA}{4}%
		\setnumchoice{\BA}{\BA}{\BA}{\MO}{\MO}{5}%
		\setnumchoice{\BA}{\RU}{\BA}{\BA}{\BA}{6}%
		\setnumchoice{\RU}{\BA}{\BA}{\BA}{\BA}{7}%
		\setnumchoice{\HA}{\HA}{\BA}{\BA}{\BA}{8}%
		\setnumchoice{\HA}{\HA}{\HA}{\HA}{\MO}{9}%
		\setnumchoice{\RU}{\BA}{\RU}{\BA}{\MO}{10}%
		\setnumchoice{\BA}{\RU}{\BA}{\RU}{\MO}{11}%
		\setcounter{numChoice}{\numchoice}%
		\ifcase\value{numChoice}\relax%
			\setlength{\dorong}{\dimexpr(\linewidth - 4\fboxsep)/\socot-\widthalpha-3\fboxsep-0.5pt\relax}%
			\writeChoice[\socot]{#2}{#3}{#4}{#5}{#6}%
		\or \setlength{\dorong}{\rNA}{\writeChoice[5]{#2}{#3}{#4}{#5}{#6}}%
		\or \setlength{\dorong}{\rBA}{\writeChoice[3]{#2}{#3}{#4}}\setcounter{debai}{1}%
			{\writeChoice[3]{#5}}\setlength{\dorong}{\rRU}{\writeChoice{#6}}%
		\or \setlength{\dorong}{\rBA}{\writeChoice[3]{#2}{#3}{#4}}\setcounter{debai}{1}%
			\setlength{\dorong}{\rRU}{\writeChoice[2]{#5}}\setlength{\dorong}{\rBA}{\writeChoice{#6}}%
		\or \setlength{\dorong}{\rBA}{\writeChoice[3]{#2}{#3}{#4}}\setcounter{debai}{1}%
			\setlength{\dorong}{\rHA}{\writeChoice[2]{#5}{#6}}%
		\or \setlength{\dorong}{\rBA}{\writeChoice[3]{#2}{#3}{#4}}\setcounter{debai}{1}%
			\setlength{\dorong}{\rMO}{\writeChoice{#5}{#6}}%
		\or \setlength{\dorong}{\rBA}{\writeChoice[3]{#2}}%
			\setlength{\dorong}{\rRU}{\writeChoice[2]{#3}}\setcounter{debai}{1}%
			\setlength{\dorong}{\rBA}{\writeChoice[3]{#4}{#5}{#6}}%
		\or \setlength{\dorong}{\rRU}{\writeChoice[2]{#2}}%
			\setlength{\dorong}{\rBA}{\writeChoice[3]{#3}}\setcounter{debai}{1}%
			\setlength{\dorong}{\rBA}{\writeChoice[3]{#4}{#5}{#6}}%
		\or \setlength{\dorong}{\rHA}{\writeChoice[2]{#2}{#3}}\setcounter{debai}{1}%
			\setlength{\dorong}{\rBA}{\writeChoice[3]{#4}{#5}{#6}}%
		\or \setlength{\dorong}{\rHA}{\writeChoice[2]{#2}{#3}}\setcounter{debai}{1}%
			\setlength{\dorong}{\rHA}{\writeChoice[2]{#4}{#5}}\setcounter{debai}{1}%
			\setlength{\dorong}{\rMO}{\writeChoice{#6}}%
		\or \setlength{\dorong}{\rRU}{\writeChoice[2]{#2}}%
			\setlength{\dorong}{\rBA}{\writeChoice[3]{#3}}\setcounter{debai}{1}%
			\setlength{\dorong}{\rRU}{\writeChoice[2]{#4}}%
			\setlength{\dorong}{\rBA}{\writeChoice[3]{#5}}\setcounter{debai}{1}%
			\setlength{\dorong}{\rMO}{\writeChoice{#6}}%
		\or \setlength{\dorong}{\rBA}{\writeChoice[3]{#2}}%
			\setlength{\dorong}{\rRU}{\writeChoice[2]{#3}}\setcounter{debai}{1}%
			\setlength{\dorong}{\rBA}{\writeChoice[3]{#4}}%
			\setlength{\dorong}{\rRU}{\writeChoice[2]{#5}}\setcounter{debai}{1}%
