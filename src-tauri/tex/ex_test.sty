\newcommand{\BuildAnsBoxEX}[3]{%
	\def\coefAns{1}%					% Mặc định hệ số nhân = 1
	\ifdefined\numCellsAnsBox%
		\ifx\numCellsAnsBox\empty\else\def\coefAns{\numCellsAnsBox}\fi%
	\fi%
	\begin{lrbox}{\myboxans}%			% #1: Số cột chia (\numMW, \numTF, \numABCD)
		\begin{minipage}{\dimexpr\coefAns\linewidth/#1-4.2\fboxsep\relax}%
			#2\hfill\color{black}#3%	% #2: Phần tiêu đề màu xanh (vd: Câu 1.)
		\end{minipage}%					% #3: Phần nội dung (có \mbox hoặc không)
	\end{lrbox}\fbox{\usebox{\myboxans}}\;
	\gdef\numCellsAnsBox{}%
}

\newcommand{\inputansbox}[3][]{%
	\def\extest@opt{#1}%
	\def\extest@zero{0}%
	\def\extest@one{1}%
	\ifx\extest@opt\extest@zero
		\Nocirc\gdef\runTachO{0}\def\wCau{4mm}%
	\else\gdef\runTachO{1}\def\wCau{10mm}
		\ifx\extest@opt\extest@one\Fullcirc%
	\else\Onlycirc\fi\fi%
	\in@{,}{#2}%
	\ifin@
		\def\numABCD{\expandafter\firstofthreeaux#2\relax}%
		\def\numTF{\expandafter\secondofthreeaux#2\relax}%
		\def\numSA{\expandafter\thirdofthreeaux#2\relax}%
		\Onlycirc\def\numMW{3}%
	\else
		\def\numABCD{#2}\def\numTF{#2}\def\numSA{#2}\def\numMW{#2}%
	\fi%
	{\fontfamily{qcs}\small\selectfont%
	\RenewEnviron{Solution}[2][]{%
		\findkindans{\BODY}%
		\def\SttANS{##2}\def\nobox{0}%
		\ifstrempty{##1}{\def\nameans{}}{%
			\ifx\extest@opt\extest@zero\def\nameans{}\else\def\nameans{##1~}\fi%
		}%
		\ifnum\kindans=10\relax%
			\setlength{\dorongANS}{\dimexpr\linewidth/#2-4.2\fboxsep\relax}%
			\BODY%
		\else\ifnum\kindans=-1\relax% Dạng Trả lời ngắn
			\ifnum\numexpr\numSA\relax>0\relax%
				\def\coefAns{1}%
				\ifdefined\numCellsAnsBox%
					\ifx\numCellsAnsBox\empty\else\def\coefAns{\numCellsAnsBox}\fi%
				\fi%
				\setlength{\dorongANS}{\dimexpr\coefAns\linewidth/\numSA-4.2\fboxsep\relax}%
				\BODY%
				\gdef\numCellsAnsBox{}%
			\fi%
		\else\ifnum\kindans=-2\relax% Dạng Ghép đôi
			\BuildAnsBoxEX{\numMW}{\parbox[b]{\wCau}{\color{blue}\nameans##2.}}{\mbox{\BODY}}%
		\else\ifnum\kindans=1\relax% Dạng Đúng/Sai
			\ifnum\numexpr\numTF\relax>0\relax%
				\BuildAnsBoxEX{\numTF}{\parbox[b]{\wCau}{\color{blue}\nameans##2.}}{\BODY}%
			\fi%
		\else% Dạng ABCD
			\ifnum\numexpr\numABCD\relax>0\relax%
				\BuildAnsBoxEX{\numABCD}{\color{blue}##2.}{\BODY}%
			\fi%
		\fi\fi\fi\fi%
	}%
	\begin{flushleft}
		\forcsvlist{\extest@readfile}{#3}%
	\end{flushleft}%
	}%
}
