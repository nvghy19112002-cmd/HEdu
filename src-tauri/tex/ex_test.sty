\def\nameans{\nameex}%
\newcommand{\findkindans}[1]{%
	\def\kindans{0}% Mặc định là Trắc nghiệm (CHanswer)
	\edef\extest@tempstr{\detokenize\expandafter{#1}}%
	\edef\extest@run{\noexpand\in@{\detokenize{dapsoTL}}{\extest@tempstr}}\extest@run
	\ifin@ \def\kindans{10}% TLanswer
	\else
		\edef\extest@run{\noexpand\in@{\detokenize{dapsoSA}}{\extest@tempstr}}\extest@run
		\ifin@ \def\kindans{-1}% SAanswer
		\else
			\edef\extest@run{\noexpand\in@{\detokenize{circT}}{\extest@tempstr}}\extest@run
			\ifin@ \def\kindans{1}% TFanswer
			\else
				\edef\extest@run{\noexpand\in@{\detokenize{circF}}{\extest@tempstr}}\extest@run
				\ifin@ \def\kindans{1}% TFanswer
				\else
					\edef\extest@run{\noexpand\in@{\detokenize{fbox}}{\extest@tempstr}}\extest@run
					\ifin@ \def\kindans{-2}% MWanswer
					\fi%
				\fi%
			\fi%
		\fi%
	\fi%
}
