\newcommand{\choiceFix}[2][\parskipchoice]{%
	\IfInteger{#1}{}{%
		\MeasureChoice{\dimen0}{#2}%%
		\ifdim\widthch<\dimen0\relax\global\widthch=\dimen0\relax\fi}%
	\ifnum\chType=1\relax\else\xdef\numPA{\the\numexpr\numPA+1\relax}\fi%
	\xdef\DanhSachChoice{\unexpanded\expandafter{\DanhSachChoice}\unexpanded{{#2}}}%
	\@ifnextchar\bgroup{\choiceFix[#1]}{%
		\IfInteger{#1}{\edef\socot{#1}}
			{\def\pkchoice{#1}%
			%	\edef\socot{\fpeval{ceil( \numPA / ceil( \numPA / max(1, floor( (\linewidth - 4\fboxsep - 1pt) / (\widthch + \widthalpha + 3\fboxsep) ) ) ) )}}%
				\edef\extest@maxcols{\the\numexpr \dimexpr 2\linewidth - \widthch - \widthalpha - 11\fboxsep - 2pt\relax / \dimexpr 2\widthch + 2\widthalpha + 6\fboxsep\relax \relax}%
				\ifnum\extest@maxcols<1 \def\extest@maxcols{1}\fi%
				\edef\extest@rows{\the\numexpr (10*\numPA+5*\extest@maxcols-1) / (10*\extest@maxcols) \relax}%
				\edef\socot{\the\numexpr (10*\numPA+5*\extest@rows-1) / (10*\extest@rows) \relax}}%
		\par\setlength{\parskip}{\pkchoice}\noindent%
		\edef\ThucThiLenh{%
			\ifnum\numPA=5\relax%
				{\noexpand\choicefive[#1]\unexpanded\expandafter{\DanhSachChoice}}%
			\else%
				{\noexpand\choiceint[\socot]\unexpanded\expandafter{\DanhSachChoice}}%
			\fi\par\noindent%
		}%
		\ThucThiLenh%
		\xdef\numPA{0}%
		\gdef\DanhSachChoice{}%
		\global\widthch=0pt\relax%
	}%
}
\newcommand{\choiceint}[1][1]{\savekinditch%
