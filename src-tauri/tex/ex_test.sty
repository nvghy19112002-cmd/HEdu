\newcommand{\fixshowansAux}[1]{%
	\ifcsdef{fixshowans#1hooked}{}{%
		\csgdef{fixshowans#1hooked}{1}%
		\AddToHook{env/#1/begin}{%
			\gdef\saveFileAns{}\gdef\keyEX{}\gdef\chType{9}%
			\setcounter{dapan}{0}%
			\def\dotEX{.}%
			\def\labelex{}}%
		\AddToHook{env/#1/end}{\def\isSpecial{0}%
			\edef\extest@run{\noexpand\in@{,\chType,}{,1,-1,-2,10,}}\extest@run
			\ifin@ \def\isSpecial{1}\fi%
			\ifdefempty{\saveFileAns}{}{%
				\ifdefempty{\labelthm}{\Writetofile{ans}{\string\begin{Solution}{\Currentlabel}}}%
					{\ifnum\isSpecial=1\relax%
						\Writetofile{ans}{\string\begin{Solution}[\detokenize\expandafter{\labelthm}]{\Currentlabel}}%
					\else%
						\Writetofile{ans}{\string\begin{Solution}{\Currentlabel}}%
					\fi}%
				\Writetofile{ans}{\saveFileAns^^J\string\end{Solution}}}%
			\gdef\saveFileAns{}\gdef\keyEX{}\gdef\chType{9}\gdef\addques{}\gdef\addans{}%
			\labelex}}%
}
\newcommand{\fixshowans}[1]{\forcsvlist{\fixshowansAux}{#1}}
