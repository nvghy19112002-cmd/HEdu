					\setlength{\paroutindent}{\expandafter\parindent}%
					\setbox0=\vbox\bgroup%
						\setlength{\hsize}{\linewidth}%
						\setlength{\textwidth}{\linewidth}%
						\setlength{\columnwidth}{\linewidth}%
						\@parboxrestore
						\setlength{\parindent}{\paroutindent}%
				}
				\global\def\endloigiai{%
					\egroup%
					\linepar=\dimexpr\ht0+\dp0\relax%
					\edef\extest@LineHeight{\dimexpr\linespacing\dimexpr 18.5pt\relax\relax}%
					\edef\TotalLines{\the\numexpr\dimexpr\linepar-\fboxsep\relax / \extest@LineHeight\relax}%
					\ifdim\dimexpr\TotalLines\extest@LineHeight\relax < \dimexpr\linepar-\fboxsep\relax%
						\edef\TotalLines{\the\numexpr\TotalLines+1\relax}%
					\fi%
					\IfInteger{#1}{\dotlineEXb[#1]{\TotalLines}[#3]}{\dotlineEXb{\TotalLines}[#3]}%
				}%
				\SetupSmartLoiGiai%
			}%
			\AddToHook{env/##1/end}{%
				\global\expandafter\let\expandafter\loigiai\csname orig@loigiai@##1\endcsname
				\global\expandafter\let\expandafter\endloigiai\csname orig@endloigiai@##1\endcsname
			}%
		}%
	}%
}
